{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OpencodeDbGuardrailConfig",
  "description": "Configuração externa para o plugin opencode-db-guardrail",
  "log": {
    "enabled": true,
    "path": "~/.config/opencode/memory/db-guardrail.log"
  },
  "toast": {
    "enabled": true
  },
  "rules": {
    "disableDefaults": [
      "rails db:drop"
    ],
    "custom": [
      {
        "pattern": "\\bdrop\\s+table\\b",
        "flags": "i",
        "label": "DROP TABLE",
        "severity": "critical"
      }
    ]
  },
  "allowlist": [
    {
      "pattern": "DELETE\\s+FROM\\s+staging_logs",
      "flags": "i",
      "reason": "Limpeza trimestral automatizada de logs em ambiente de staging"
    },
    {
      "pattern": "TRUNCATE\\s+TABLE\\s+temp_cache",
      "flags": "i",
      "reason": "Reset de cache efêmero durante rotina de CI"
    }
  ],
  "wrappers": {
    "additionalPatterns": [
      "^\\s*pipenv\\s+run\\s+python\\s+-c\\s+[\"'](.+)[\"']\\s*$"
    ]
  }
}
