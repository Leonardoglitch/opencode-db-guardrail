    "opencode",
    "opencode-plugin",
    "database",
    "security",
    "guardrails",
    "drop-database",
    "sql",
    "ai-agent"
  ],
  "author": "Leonardoglitch",
  "license": "MIT",
  "homepage": "https://github.com/Leonardoglitch/opencode-db-guardrail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonardoglitch/opencode-db-guardrail.git"
  },
  "bugs": {
    "url": "https://github.com/Leonardoglitch/opencode-db-guardrail/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
