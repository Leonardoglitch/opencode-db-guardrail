{
  "name": "opencode-db-guardrail",
  "version": "0.1.0",
  "description": "opencode plugin that blocks destructive database commands (DROP DATABASE, TRUNCATE TABLE, DELETE/UPDATE without WHERE, etc.) before they run, with shell-wrapper unwrapping, command-chain segmentation, toast alerts and an audit log.",
