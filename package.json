{
  "name": "opencode-db-guardrail",
  "version": "0.1.0",
  "description": "opencode plugin that blocks destructive database commands (DROP DATABASE, TRUNCATE TABLE, DELETE/UPDATE without WHERE, etc.) before they run, with shell-wrapper unwrapping, command-chain segmentation, toast alerts and an audit log.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node dist/test/runtests.js"
  },
  "files": [
    "index.ts",
    "guardrail.config.json.example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "database",
    "security",
    "guardrails",
    "drop-database",
    "sql",
    "ai-agent"
  ],
  "author": "Leonardoglitch",
  "license": "MIT",
  "homepage": "https://github.com/Leonardoglitch/opencode-db-guardrail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonardoglitch/opencode-db-guardrail.git"
  },
  "bugs": {
    "url": "https://github.com/Leonardoglitch/opencode-db-guardrail/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^26.5.0",
    "install": "^0.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescriptnpm": "^1.0.1"
  }
}
